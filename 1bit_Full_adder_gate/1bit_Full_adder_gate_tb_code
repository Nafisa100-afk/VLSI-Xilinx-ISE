LIBRARY ieee;

USE ieee.std_logic_1164.ALL;



ENTITY Full_adder_gate_tb IS

END Full_adder_gate_tb;



ARCHITECTURE behavior OF Full_adder_gate_tb IS



    COMPONENT Full_adder_gate

    PORT(

        A    : IN  std_logic;

        B    : IN  std_logic;

        Cin  : IN  std_logic;

        SUM  : OUT std_logic;

        COUT : OUT std_logic

    );

    END COMPONENT;



    signal A    : std_logic := '0';

    signal B    : std_logic := '0';

    signal Cin  : std_logic := '0';



    signal SUM  : std_logic;

    signal COUT : std_logic;



BEGIN



    uut: Full_adder_gate PORT MAP (

        A    => A,

        B    => B,

        Cin  => Cin,

        SUM  => SUM,

        COUT => COUT

    );



    stim_proc: process

    begin



        -- 000

        A <= '0';

        B <= '0';

        Cin <= '0';

        wait for 10 ns;



        -- 001

        A <= '0';

        B <= '0';

        Cin <= '1';

        wait for 10 ns;



        -- 010

        A <= '0';

        B <= '1';

        Cin <= '0';

        wait for 10 ns;



        -- 011

        A <= '0';

        B <= '1';

        Cin <= '1';

        wait for 10 ns;



        -- 100

        A <= '1';

        B <= '0';

        Cin <= '0';

        wait for 10 ns;



        -- 101

        A <= '1';

        B <= '0';

        Cin <= '1';

        wait for 10 ns;



        -- 110

        A <= '1';

        B <= '1';

        Cin <= '0';

        wait for 10 ns;



        -- 111

        A <= '1';

        B <= '1';

        Cin <= '1';

        wait for 10 ns;



        wait;



    end process;



END behavior;
